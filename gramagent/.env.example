# Run API/worker from gramagent/. Copy to .env, then replace placeholders.
GRAM_ENVIRONMENT=development
GRAM_DATA_DIR=.gramagent
GRAM_JWT_SECRET=replace-with-at-least-32-random-characters
GRAM_FRONTEND_ORIGIN=http://localhost:5174
GRAM_BOOTSTRAP_EMAIL=admin@example.test
GRAM_BOOTSTRAP_PASSWORD=replace-with-a-unique-16-character-password
# SQLite is development only. Production requires a separate MongoDB database.
GRAM_MONGO_URI=
GRAM_MONGO_DATABASE=gramagent
# none = deterministic analysis only. OpenAI/Gemini require model and key.
GRAM_MODEL_PROVIDER=none
GRAM_MODEL_NAME=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Explicit source integration. Never use the source database for GramAgent storage.
GRAM_VILLAGE360_URL=
GRAM_VILLAGE360_TOKEN=
GRAM_VILLAGE360_MONGO_URI=
GRAM_VILLAGE360_DATABASE=village360
# Optional Atlas Vector Search; without this, reviewed sources use TF-IDF.
GRAM_VECTOR_INDEX=
GRAM_EMBEDDING_MODEL=
GRAM_RETENTION_DAYS=365
